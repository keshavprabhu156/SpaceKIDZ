// International Space Curriculum — production data model.
//
// This is LIVE: the app reads and writes this schema through Prisma against
// PostgreSQL (Supabase). Auth, weekly tests and progress all run on it.
//
// Multi-tenancy: every school is a `School` row. Teachers, classes and students
// all hang off it, so ALL queries must be scoped by schoolId — a teacher must
// never be able to read another school's data. See services/teacherService.ts.
//
// Changing this file: edit the model, then run `npm run db:migrate` (never hand-
// write SQL) and commit the generated migration folder.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  SCHOOL_ADMIN // principal / coordinator — manages ONE school
  ADMIN // platform owner — manages all schools
}

model User {
  id           String    @id // e.g. ISC-S-2026-000123
  email        String    @unique
  passwordHash String
  role         Role
  name         String
  createdAt    DateTime  @default(now())
  student      Student?
  teacher      Teacher?
}

model Student {
  userId        String   @id
  user          User     @relation(fields: [userId], references: [id])
  dateOfBirth   DateTime
  gender        String
  grade         Int
  schoolId      String?
  school        School?  @relation(fields: [schoolId], references: [id])
  schoolName    String
  phone         String
  parentName    String
  parentContact String
  city          String
  state         String
  countryCode   String
  country       Country  @relation(fields: [countryCode], references: [code])
  language      String
  timezone      String
  xp            Int      @default(0)
  spaceCoins    Int      @default(0)
  streakDays    Int      @default(0)
  // Last time the student opened a lesson or test — powers the teacher's
  // "needs attention" list.
  lastActiveAt  DateTime?
  // A student belongs to one class (section). Without this a teacher has no
  // roster, so every class view depends on it.
  classId       String?
  class         Class?   @relation(fields: [classId], references: [id])
  progress      LessonProgress[]
  testAttempts  TestAttempt[]
  badges        StudentBadge[]
  attendance    Attendance[]
}

model Teacher {
  userId  String  @id
  user    User    @relation(fields: [userId], references: [id])
  schoolId String?
  school  School? @relation(fields: [schoolId], references: [id])
  classes Class[]
}

model Country {
  code     String    @id // ISO-3166 alpha-2
  name     String
  students Student[]
  schools  School[]
}

model School {
  id          String    @id @default(cuid())
  name        String
  city        String?
  countryCode String
  country     Country   @relation(fields: [countryCode], references: [code])
  // Teachers self-enrol with this code instead of being created by hand.
  teacherCode String    @unique
  academicYear String?  // e.g. "2026-27"
  createdAt   DateTime  @default(now())
  students    Student[]
  teachers    Teacher[]
  classes     Class[]
  announcements Announcement[]
}

model Class {
  id        String   @id @default(cuid())
  name      String // e.g. "Section A"
  grade     Int
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [userId])
  // Students join with this code.
  joinCode  String   @unique
  createdAt DateTime @default(now())
  students  Student[]
  assignments Assignment[]
  attendance  Attendance[]
  announcements Announcement[]
}

// ---------------- Curriculum ----------------

model GradeTier {
  grade    Int    @id // 4..10
  codename String
  tagline  String
  theme    String
  color    String
  terms    Term[]
}

model Term {
  id       String    @id
  title    String
  grade    Int
  tier     GradeTier @relation(fields: [grade], references: [grade])
  order    Int
  chapters Chapter[]
}

model Chapter {
  id            String   @id
  title         String
  description   String
  order         Int
  termId        String
  term          Term     @relation(fields: [termId], references: [id])
  hasWeeklyTest Boolean  @default(true)
  lessons       Lesson[]
  tests         WeeklyTest[]
  assignments   Assignment[]
}

model Lesson {
  id        String  @id
  title     String
  type      String // reading | 3d-model | activity | experiment | simulation | quiz
  //                  (no video/animation — the curriculum is book material + quizzes)
  body      String? // book text for `reading` lessons
  duration  Int
  xp        Int
  order     Int
  contentUrl String? // cloud-storage pointer for figures/diagrams or an interactive bundle
  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id])
  progress  LessonProgress[]
}

model LessonProgress {
  studentId String
  lessonId  String
  student   Student  @relation(fields: [studentId], references: [userId])
  lesson    Lesson   @relation(fields: [lessonId], references: [id])
  completed Boolean  @default(false)
  score     Int?
  updatedAt DateTime @updatedAt

  @@id([studentId, lessonId])
}

// ---------------- Assessment ----------------

model WeeklyTest {
  id        String        @id @default(cuid())
  chapterId String
  chapter   Chapter       @relation(fields: [chapterId], references: [id])
  questions Question[]
  attempts  TestAttempt[]
  assignments Assignment[]
}

model Question {
  id      String     @id @default(cuid())
  testId  String
  test    WeeklyTest @relation(fields: [testId], references: [id])
  kind    String // mcq | boolean | match | drag-drop | image | label | short | numeric
  payload Json // prompt, options, answers, assets, explanation
}

model TestAttempt {
  id        String     @id @default(cuid())
  studentId String
  student   Student    @relation(fields: [studentId], references: [userId])
  testId    String
  test      WeeklyTest @relation(fields: [testId], references: [id])
  score     Int
  answers   Json
  createdAt DateTime   @default(now())
}

// ---------------- Gamification ----------------

model Badge {
  id          String         @id
  title       String
  description String
  tier        String // bronze | silver | gold | platinum
  icon        String
  students    StudentBadge[]
}

model StudentBadge {
  studentId String
  badgeId   String
  student   Student  @relation(fields: [studentId], references: [userId])
  badge     Badge    @relation(fields: [badgeId], references: [id])
  earnedAt  DateTime @default(now())

  @@id([studentId, badgeId])
}

// ---------------- Teaching workflow ----------------
// The teacher sidebar already links to these features; these are the tables
// behind them.

/** A chapter or test given to a class, with a deadline. */
model Assignment {
  id        String      @id @default(cuid())
  classId   String
  class     Class       @relation(fields: [classId], references: [id])
  title     String
  chapterId String?
  chapter   Chapter?    @relation(fields: [chapterId], references: [id])
  testId    String?
  test      WeeklyTest? @relation(fields: [testId], references: [id])
  dueAt     DateTime
  createdAt DateTime    @default(now())
}

model Attendance {
  id        String   @id @default(cuid())
  classId   String
  class     Class    @relation(fields: [classId], references: [id])
  studentId String
  student   Student  @relation(fields: [studentId], references: [userId])
  date      DateTime // date only; time component unused
  present   Boolean
  note      String?

  // One record per student per class per day.
  @@unique([classId, studentId, date])
}

/** Posted to one class, or to the whole school when classId is null. */
model Announcement {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  classId   String?
  class     Class?   @relation(fields: [classId], references: [id])
  authorId  String // User.id of the teacher or school admin
  title     String
  body      String
  createdAt DateTime @default(now())
}
