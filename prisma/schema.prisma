// International Space Curriculum — production data model.
//
// The app currently runs on an in-memory dev store (src/lib/users.ts) and
// static content modules (src/data/*). This schema is the target model those
// modules already mirror — wiring it up means:
//   1. npm i prisma @prisma/client && npx prisma migrate dev
//   2. Replace src/lib/users.ts internals with Prisma queries (same signatures)
//   3. Serve src/data shapes from /api/curriculum etc.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

model User {
  id           String    @id // e.g. ISC-S-2026-000123
  email        String    @unique
  passwordHash String
  role         Role
  name         String
  createdAt    DateTime  @default(now())
  student      Student?
  teacher      Teacher?
}

model Student {
  userId        String   @id
  user          User     @relation(fields: [userId], references: [id])
  dateOfBirth   DateTime
  gender        String
  grade         Int
  schoolId      String?
  school        School?  @relation(fields: [schoolId], references: [id])
  schoolName    String
  phone         String
  parentName    String
  parentContact String
  city          String
  state         String
  countryCode   String
  country       Country  @relation(fields: [countryCode], references: [code])
  language      String
  timezone      String
  xp            Int      @default(0)
  spaceCoins    Int      @default(0)
  streakDays    Int      @default(0)
  progress      LessonProgress[]
  testAttempts  TestAttempt[]
  badges        StudentBadge[]
}

model Teacher {
  userId  String  @id
  user    User    @relation(fields: [userId], references: [id])
  schoolId String?
  school  School? @relation(fields: [schoolId], references: [id])
  classes Class[]
}

model Country {
  code     String    @id // ISO-3166 alpha-2
  name     String
  students Student[]
  schools  School[]
}

model School {
  id          String    @id @default(cuid())
  name        String
  countryCode String
  country     Country   @relation(fields: [countryCode], references: [code])
  students    Student[]
  teachers    Teacher[]
  classes     Class[]
}

model Class {
  id        String   @id @default(cuid())
  name      String
  grade     Int
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [userId])
}

// ---------------- Curriculum ----------------

model GradeTier {
  grade    Int    @id // 4..10
  codename String
  tagline  String
  theme    String
  color    String
  terms    Term[]
}

model Term {
  id       String    @id
  title    String
  grade    Int
  tier     GradeTier @relation(fields: [grade], references: [grade])
  order    Int
  chapters Chapter[]
}

model Chapter {
  id            String   @id
  title         String
  description   String
  order         Int
  termId        String
  term          Term     @relation(fields: [termId], references: [id])
  hasWeeklyTest Boolean  @default(true)
  lessons       Lesson[]
  tests         WeeklyTest[]
}

model Lesson {
  id        String  @id
  title     String
  type      String // video | animation | 3d-model | activity | experiment | simulation | reading | quiz
  duration  Int
  xp        Int
  order     Int
  contentUrl String? // cloud-storage pointer for video/GLTF/interactive bundle
  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id])
  progress  LessonProgress[]
}

model LessonProgress {
  studentId String
  lessonId  String
  student   Student  @relation(fields: [studentId], references: [userId])
  lesson    Lesson   @relation(fields: [lessonId], references: [id])
  completed Boolean  @default(false)
  score     Int?
  updatedAt DateTime @updatedAt

  @@id([studentId, lessonId])
}

// ---------------- Assessment ----------------

model WeeklyTest {
  id        String        @id @default(cuid())
  chapterId String
  chapter   Chapter       @relation(fields: [chapterId], references: [id])
  questions Question[]
  attempts  TestAttempt[]
}

model Question {
  id      String     @id @default(cuid())
  testId  String
  test    WeeklyTest @relation(fields: [testId], references: [id])
  kind    String // mcq | boolean | match | drag-drop | image | label | short | numeric
  payload Json // prompt, options, answers, assets, explanation
}

model TestAttempt {
  id        String     @id @default(cuid())
  studentId String
  student   Student    @relation(fields: [studentId], references: [userId])
  testId    String
  test      WeeklyTest @relation(fields: [testId], references: [id])
  score     Int
  answers   Json
  createdAt DateTime   @default(now())
}

// ---------------- Gamification ----------------

model Badge {
  id          String         @id
  title       String
  description String
  tier        String // bronze | silver | gold | platinum
  icon        String
  students    StudentBadge[]
}

model StudentBadge {
  studentId String
  badgeId   String
  student   Student  @relation(fields: [studentId], references: [userId])
  badge     Badge    @relation(fields: [badgeId], references: [id])
  earnedAt  DateTime @default(now())

  @@id([studentId, badgeId])
}
