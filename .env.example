# Copy to .env.local for development
# Secret used to sign JWT session tokens — REQUIRED in production
JWT_SECRET=generate-a-long-random-string

# Wired up when the Prisma/PostgreSQL backend lands (see prisma/schema.prisma)
DATABASE_URL=postgresql://user:password@localhost:5432/space_curriculum

# Optional infrastructure (architecture-ready)
# REDIS_URL=redis://localhost:6379
# CLOUD_STORAGE_BUCKET=isc-assets
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
